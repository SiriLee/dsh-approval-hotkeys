{
  "name": "dsh-approval-hotkeys",
  "version": "0.2.0",
  "description": "Panel hotkeys for every interaction panel: Enter confirms, Esc cancels · 交互面板快捷键：Enter 确认、Esc 取消",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "approval",
    "hotkey",
    "keyboard",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiriLee/dsh-approval-hotkeys.git"
  },
  "homepage": "https://github.com/SiriLee/dsh-approval-hotkeys#readme",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "assets",
    "cordis.patch.yml",
    "docs",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "verify:host": "node scripts/verify-host.mjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/verify-host.mjs && npm pack --dry-run",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.0.5-0",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/cosmokit": "1.8.6-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-native-command": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
